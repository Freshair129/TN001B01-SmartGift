# Static hosting on Apache / DirectAdmin.
# The catalog is plain HTML + JS + JSON — no PHP and no Node runtime involved.

Options -Indexes
DirectoryIndex index.html

# The internal dashboard carries factory cost, landed cost and margin figures.
# It must never be reachable from a public host, even by direct URL.
<FilesMatch "^internal\.html$">
  Require all denied
</FilesMatch>

<IfModule mod_mime.c>
  AddType image/webp                .webp
  AddType model/gltf-binary         .glb
  AddType application/json          .json
  AddType font/woff2                .woff2
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # artwork and code are content-addressed by filename in practice
  ExpiresByType image/webp          "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
  ExpiresByType image/png           "access plus 30 days"
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  # catalog data changes with each pipeline run — keep it short
  ExpiresByType application/json    "access plus 10 minutes"
  ExpiresByType text/html           "access plus 10 minutes"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
