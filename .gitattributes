# Provenance hashes are taken over these files' bytes (pricing_formula_registry.json,
# export_pricelist_master.py's guard, pricing-config.json's source_sha256). With
# core.autocrlf=true a Windows checkout rewrites LF to CRLF and every one of those
# hashes changes, so the formula config and its archives are pinned to LF.
config/pricing_rules_formula.yaml text eol=lf
price-boss/pricing-config.json text eol=lf
data-pipeline/01_raw/archive/pricing_formulas/*.yaml text eol=lf
